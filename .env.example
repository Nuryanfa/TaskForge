# Development-only defaults. Do not use these credentials in production.
TASKFORGE_HTTP_ADDR=127.0.0.1:8080
TASKFORGE_DATABASE_URL=postgres://taskforge:taskforge@localhost:5432/taskforge?sslmode=disable
TASKFORGE_POSTGRES_PORT=5432
TASKFORGE_DATABASE_MAX_CONNS=10
TASKFORGE_DATABASE_MIN_CONNS=1
TASKFORGE_DATABASE_CONNECT_TIMEOUT=5s
TASKFORGE_DATABASE_QUERY_TIMEOUT=3s
TASKFORGE_READ_TIMEOUT=15s
TASKFORGE_READ_HEADER_TIMEOUT=5s
TASKFORGE_WRITE_TIMEOUT=15s
TASKFORGE_IDLE_TIMEOUT=60s
TASKFORGE_SHUTDOWN_TIMEOUT=10s
TASKFORGE_WORKER_ID=local-worker-1
TASKFORGE_WORKER_POLL_INTERVAL=500ms
TASKFORGE_WORKER_CONCURRENCY=4
TASKFORGE_JOB_EXECUTION_TIMEOUT=30s
TASKFORGE_JOB_LEASE_DURATION=30s
TASKFORGE_JOB_HEARTBEAT_INTERVAL=10s
TASKFORGE_RECOVERY_INTERVAL=5s
TASKFORGE_RECOVERY_BATCH_SIZE=100
TASKFORGE_SCHEDULE_INTERVAL=1s
TASKFORGE_SCHEDULE_BATCH_SIZE=50
TASKFORGE_JOB_MAX_ATTEMPTS=3
TASKFORGE_RETRY_INITIAL_BACKOFF=1s
TASKFORGE_RETRY_MAX_BACKOFF=60s
TASKFORGE_RETRY_JITTER_PERCENT=20
TASKFORGE_DEAD_LETTER_PAGE_SIZE=50
TASKFORGE_WORKFLOW_MAX_STEPS=32
TASKFORGE_WORKFLOW_MAX_BYTES=262144
TASKFORGE_WORKFLOW_PAGE_SIZE=50
TASKFORGE_JOB_PAYLOAD_MAX_BYTES=65536
TASKFORGE_JOB_RESULT_MAX_BYTES=65536
TASKFORGE_NATS_URL=nats://localhost:4222
TASKFORGE_NATS_PORT=4222
TASKFORGE_NATS_CONNECT_TIMEOUT=5s
TASKFORGE_NATS_PUBLISH_TIMEOUT=2s
TASKFORGE_NATS_STREAM=TASKFORGE_EVENTS
TASKFORGE_NATS_STREAM_MAX_AGE=168h
TASKFORGE_NATS_DUPLICATE_WINDOW=2m
TASKFORGE_OUTBOX_POLL_INTERVAL=200ms
TASKFORGE_OUTBOX_BATCH_SIZE=100
TASKFORGE_OUTBOX_BATCH_TIMEOUT=10s
TASKFORGE_OUTBOX_RETENTION=24h
# Observability (v0.7). Empty endpoint disables tracing.
TASKFORGE_OTEL_ENDPOINT=
TASKFORGE_OTEL_SAMPLE_RATIO=1
TASKFORGE_OTEL_EXPORT_TIMEOUT=5s
# Per process default: API 127.0.0.1:9101, worker 127.0.0.1:9102, relay 127.0.0.1:9103.
# TASKFORGE_METRICS_ADDR=127.0.0.1:9102
TASKFORGE_METRICS_QUEUES=default
TASKFORGE_METRICS_DB_REFRESH=15s
